#!/usr/bin/env python3
"""Project tooling. Uses only the host Python standard library and Docker."""
from pathlib import Path
import hashlib
import json
import os
import subprocess
import sys

root = Path(__file__).resolve().parent
base = ['docker', 'compose']
def run(args, **kwargs):
    environment = dict(os.environ, FUNMMO_BROWSER_UID=str(os.getuid()), FUNMMO_BROWSER_GID=str(os.getgid()))
    return subprocess.run(base + args, cwd=root, env=environment, check=True, **kwargs)

try:
    action = sys.argv[1] if len(sys.argv) > 1 else 'help'
    if action == 'bootstrap':
        subprocess.run([sys.executable,str(root/'tools/bootstrap.py')],check=True)
    elif action == 'image':
        binary = root / '.tools' / 'sfw'
        with binary.open('rb') as stream:
            if hashlib.file_digest(stream,'sha256').hexdigest() != '28b6dc864d6bbc8bbd41f85a0e894f91f4ab41f2fc1c304c0c08e29da63ccf69':
                raise ValueError('Socket checksum mismatch')
        run(['build','tooling'])
    elif action in ['policy-test','metadata','resolve','audit','install','build','test']:
        if action != 'metadata' and len(sys.argv) > 2:
            raise ValueError('This command does not accept overrides')
        run(['run','--rm','-T','tooling','node','/source/tools/task.mjs',action,*sys.argv[2:]])
        if action == 'resolve':
            for operation, dest in [('export-lock','package-lock.json'),('export-age','security/dependency-ages.json')]:
                result = run(['run','--rm','-T','tooling','node','/source/tools/task.mjs',operation],capture_output=True,text=True)
                json.loads(result.stdout)
                (root / dest).write_text(result.stdout)
    elif action == 'up':
        run(['up','-d','--force-recreate','tooling'])
    elif action == 'browser':
        if os.getuid() == 0:
            raise ValueError('Run browser tests from an unprivileged host account')
        (root / 'artifacts').mkdir(exist_ok=True)
        run(['run','--rm','-T','browser'])
    elif action in ['down','logs']:
        run([action])
    else:
        print('Usage: ./dev bootstrap | image | policy-test | metadata PACKAGE... | resolve | audit | install | build | test | up | browser | down | logs')
except (subprocess.CalledProcessError, OSError, ValueError) as error:
    print(str(error),file=sys.stderr)
    sys.exit(1)
